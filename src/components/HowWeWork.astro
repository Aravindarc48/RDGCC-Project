
---
interface Step {
  stepNumber: string
  icon: 'search' | 'palette' | 'rocket' | 'settings'
  title: string
  description: string
}

interface Props {
  heading?: string
  description?: string
  steps?: Step[]
}

const { heading, description, steps = [] } = Astro.props
---

<section class="how-we-work">
  <div class="section-header">
    <h2>{heading}</h2>
    <p>{description}</p>
  </div>

  <div class="steps-grid">
    {steps.map((step, index) => (
      <article class="step-card">
        <div class="step-number">{step.stepNumber}</div>

        <div class="step-icon">
          {step.icon === 'search' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="7.5" />
              <path d="m16 16 5 5" />
            </svg>
          )}

          {step.icon === 'palette' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <path d="M12 3a9 9 0 1 0 0 18h1.5a2 2 0 0 0 1.4-3.4 1.8 1.8 0 0 1 1.3-3.1H19a2 2 0 0 0 2-2A9 9 0 0 0 12 3Z" />
              <circle cx="7.5" cy="10" r="1" />
              <circle cx="10" cy="6.5" r="1" />
              <circle cx="15" cy="7.5" r="1" />
            </svg>
          )}

          {step.icon === 'rocket' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <path d="M4.5 16.5c-1.5 1.5-1.5 4-1.5 4s2.5 0 4-1.5" />
              <path d="M12 15l-3-3 4-7c2-2 5-2 7-2 0 2 0 5-2 7l-6 5Z" />
              <path d="m9 12-4 1-2 4 5-1" />
              <path d="m12 15-1 4 4-2 1-4" />
              <circle cx="15.5" cy="8.5" r="1.5" />
            </svg>
          )}

          {step.icon === 'settings' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z" />
              <path d="m19.4 15 .1.1 1.1 1.9-1.7 2.9-2.2-.5a8 8 0 0 1-1.8 1l-.8 2.1h-3.4l-.8-2.1a8 8 0 0 1-1.8-1l-2.2.5-1.7-2.9 1.1-1.9a8 8 0 0 1 0-2l-1.1-1.9 1.7-2.9 2.2.5a8 8 0 0 1 1.8-1l.8-2.1h3.4l.8 2.1a8 8 0 0 1 1.8 1l2.2-.5 1.7 2.9-1.1 1.9a8 8 0 0 1 0 2Z" />
            </svg>
          )}
        </div>

        <h3>{step.title}</h3>
        <p class="step-description">{step.description}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .how-we-work {
    padding: 88px 24px;
    background: #fff;
  }

  .section-header {
    text-align: center;
    max-width: 1100px;
    margin: 0 auto 72px;
  }

  .section-header h2 {
    color: #064f8c;
    font-size: 36px;
    font-weight: 500;
    margin: 0 0 20px;
  }

  .section-header p {
    color: #333;
    font-size: 18px;
    line-height: 1.7;
    margin: 0;
  }

  .steps-grid {
    max-width: 1370px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 26px;
  }

  .step-card {
    position: relative;
    min-height: 280px;
    padding: 34px;
    overflow: hidden;
    border: 1px solid #edf1f6;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 12px 35px rgba(20, 52, 90, 0.04);
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .step-card::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 4px;
    background: #064f8c;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .step-card::after {
    content: "";
    position: absolute;
    top: -1px;
    right: -1px;
    width: 138px;
    height: 138px;
    border-radius: 0 18px 0 100%;
    background: #f1f4f8;
    transform: translate(100%, -100%);
    transition: transform 0.3s ease;
    pointer-events: none;
  }

  .step-card:hover,
  .step-card:focus-visible {
    transform: translateY(-8px);
    border-color: #cbdced;
    box-shadow: 0 24px 45px rgba(20, 52, 90, 0.12);
    outline: none;
  }

  .step-card:hover::before,
  .step-card:focus-visible::before {
    transform: scaleX(1);
  }

  .step-card:hover::after,
  .step-card:focus-visible::after {
    transform: translate(0, 0);
  }

  .step-number {
    position: absolute;
    top: 28px;
    right: 30px;
    z-index: 1;
    color: #064f8c;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 3px;
  }

  .step-icon {
    position: relative;
    z-index: 1;
    width: 62px;
    height: 62px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: #f1f4f8;
    color: #064f8c;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .step-icon svg {
    width: 34px;
    height: 34px;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .step-card:hover .step-icon,
  .step-card:focus-visible .step-icon {
    background: #064f8c;
    color: #fff;
  }

  .step-card h3 {
    position: relative;
    z-index: 1;
    color: #064f8c;
    font-size: 22px;
    font-weight: 500;
    margin: 28px 0 14px;
  }

  .step-description {
    position: relative;
    z-index: 1;
    color: #333;
    font-size: 16px;
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 1100px) {
    .steps-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .how-we-work {
      padding: 60px 20px;
    }

    .section-header {
      margin-bottom: 40px;
    }

    .section-header h2 {
      font-size: 30px;
    }

    .section-header p {
      font-size: 16px;
    }

    .steps-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .step-card {
      min-height: auto;
      padding: 28px;
    }
  }
</style>
