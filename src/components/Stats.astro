
---
interface Stat {
  value: string
  label: string
}

interface Props {
  heading?: string
  description?: string
  stats?: Stat[]
}

const { heading, description, stats = [] } = Astro.props
---

{
  heading && description && stats.length > 0 && (
    <section class="stats-section">
      <div class="stats-container">
        <div class="stats-intro">
          <h2>{heading}</h2>
          <p>{description}</p>
        </div>

        <div class="stats-grid">
          {stats.map((stat) => (
            <article class="stat-card">
              <h3>{stat.value}</h3>
              <p>{stat.label}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .stats-section {
    background: #e9e9e9;
    padding: 100px 24px;
  }

  .stats-container {
    max-width: 1370px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: center;
    gap: 60px;
  }

  .stats-intro h2 {
    font-size: 44px;
    font-weight: 400;
    color: #07518c;
    margin-bottom: 20px;
  }

  .stats-intro p {
    font-size: 20px;
    line-height: 1.5;
    color: #222;
    max-width: 400px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
  }

  .stat-card {
    background: #f8f9fa;
    border-radius: 20px;
    min-height: 275px;
    padding: 40px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
  }

  .stat-card h3 {
    font-size: 76px;
    line-height: 1.1;
    font-weight: 500;
    color: #07518c;
    margin-bottom: 20px;
  }

  .stat-card p {
    font-size: 25px;
    line-height: 1.3;
    color: #68778b;
  }

  @media (max-width: 900px) {
    .stats-container {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .stats-intro h2 {
      font-size: 34px;
    }

    .stats-grid {
      gap: 16px;
    }

    .stat-card {
      min-height: 190px;
      padding: 30px 15px;
    }

    .stat-card h3 {
      font-size: 48px;
    }

    .stat-card p {
      font-size: 17px;
    }
  }

  @media (max-width: 600px) {
    .stats-section {
      padding: 60px 20px;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .stat-card {
      min-height: 160px;
    }

    .stat-card h3 {
      font-size: 56px;
    }
  }
</style>
