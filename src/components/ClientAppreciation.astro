
---
import { urlFor } from '../lib/sanity'

interface Testimonial {
  companyName: string
  country?: string
  testimonial: string
  personName: string
  personRole?: string
  profileImage?: {
    asset?: {
      _ref: string
      _type: string
    }
    alt?: string
    crop?: any
    hotspot?: any
  }
  order?: number
}

interface Props {
  sectionTitle?: string
  autoplayEnabled?: boolean
  autoplayInterval?: number
  testimonials?: Testimonial[]
}

const {
  sectionTitle,
  autoplayEnabled = false,
  autoplayInterval = 5,
  testimonials = [],
} = Astro.props

const sortedTestimonials = [...testimonials].sort(
  (a, b) => (a.order ?? 0) - (b.order ?? 0)
)

const formatQuote = (text?: string) => {
  if (!text) return ''
  const trimmed = text.trim().replace(/^["“'”]+|["“'”]+$/g, '').trim()
  return `“${trimmed}”`
}
---

{sortedTestimonials.length > 0 && (
  <section
    class="client-appreciation"
    data-autoplay={autoplayEnabled}
    data-interval={autoplayInterval}
  >
    <div class="testimonial-container">

      <h2 class="testimonial-heading">{sectionTitle}</h2>

      <div class="testimonial-slider">
        {sortedTestimonials.map((item, index) => (
          <article
            class={`testimonial-slide ${index === 0 ? 'active' : ''}`}
            aria-hidden={index !== 0 ? 'true' : 'false'}
          >
            <div class="testimonial-profile">
              {item.profileImage?.asset && (
                <img
                  src={urlFor(item.profileImage)
                    .width(300)
                    .height(300)
                    .fit('crop')
                    .auto('format')
                    .url()}
                  srcset={`
                    ${urlFor(item.profileImage).width(150).height(150).fit('crop').auto('format').url()} 150w,
                    ${urlFor(item.profileImage).width(300).height(300).fit('crop').auto('format').url()} 300w
                  `}
                  sizes="135px"
                  width="135"
                  height="135"
                  alt={item.profileImage.alt ?? item.personName}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding={index === 0 ? 'sync' : 'async'}
                />
              )}
            </div>

            <div class="testimonial-content">

              <p class="testimonial-company">
                {item.companyName}
                {item.country && ` · ${item.country}`}
              </p>

              <blockquote class="testimonial-text">
                {formatQuote(item.testimonial)}
              </blockquote>

              <div class="testimonial-person">
                <h3>{item.personName}</h3>

                {item.personRole && (
                  <p>{item.personRole}</p>
                )}
              </div>

            </div>
          </article>
        ))}
      </div>

      {sortedTestimonials.length > 1 && (
        <div class="testimonial-controls">
          <div class="testimonial-dots" aria-label="Choose a testimonial">
            {sortedTestimonials.map((item, index) => (
              <button
                type="button"
                class={`testimonial-dot ${index === 0 ? 'active' : ''}`}
                aria-label={`Show testimonial ${index + 1}`}
                aria-current={index === 0 ? 'true' : 'false'}
                data-index={index}
              />
            ))}
          </div>

          {autoplayEnabled && (
            <button
              type="button"
              class="testimonial-toggle"
              aria-label="Pause testimonial autoplay"
              aria-pressed="false"
              data-autoplay-toggle
            >
              <svg class="icon-pause" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                <rect x="6" y="4" width="4" height="16" rx="1" />
                <rect x="14" y="4" width="4" height="16" rx="1" />
              </svg>
              <svg class="icon-play" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true" style="display: none;">
                <polygon points="5 3 19 12 5 21 5 3" />
              </svg>
            </button>
          )}
        </div>
      )}

    </div>
  </section>
)}

<style>
  .client-appreciation {
    width: 100%;
    background: #f7f8fa;
    padding: 75px 24px 80px;
    box-sizing: border-box;
  }

  .testimonial-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .testimonial-heading {
    text-align: center;
    color: #07518d;
    font-size: 40px;
    font-weight: 400;
    line-height: 1.3;
    margin: 0 0 95px;
  }

  .testimonial-slider {
    position: relative;
  }

  /* Main testimonial layout */
  .testimonial-slide {
    display: none;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 35px;

    /* FIX: Align image with the beginning of testimonial content */
    align-items: start;

    max-width: 1100px;
    margin: 0 auto;
    animation: testimonialFade 0.4s ease;
  }

  .testimonial-slide.active {
    display: grid;
  }

  /* Profile image */
  .testimonial-profile {
    width: 135px;
    height: 135px;
    border-radius: 50%;
    overflow: hidden;
    background: #e5eaf0;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);

    /* FIX: Position image beside company name */
    margin-top: 0;
    flex-shrink: 0;
  }

  .testimonial-profile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Company name */
  .testimonial-company {
    margin: 0 0 30px;
    color: #07518d;
    font-size: 15px;
    letter-spacing: 1.1px;
    font-weight: 500;
  }

  /* Testimonial text */
  .testimonial-text {
    margin: 0;
    color: #202b38;
    font-size: 19px;
    line-height: 1.8;
    font-weight: 400;
  }

  /* Person information */
  .testimonial-person {
    margin-top: 45px;
  }

  .testimonial-person h3 {
    margin: 0 0 8px;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.4;
    color: #17212d;
  }

  .testimonial-person p {
    margin: 0;
    color: #273747;
    font-size: 16px;
    line-height: 1.5;
  }

  /* Navigation controls */
  .testimonial-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 60px;
  }

  .testimonial-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 13px;
  }

  .testimonial-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid #cbd7e4;
    background: #ffffff;
    color: #07518d;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .testimonial-toggle:hover {
    background: #edf4fc;
    border-color: #07518d;
  }

  .testimonial-dot {
    border: none;
    padding: 0;
    width: 12px;
    height: 12px;
    border-radius: 20px;
    background: #cbd7e4;
    cursor: pointer;
    transition:
      width 0.3s ease,
      background 0.3s ease;
  }

  .testimonial-dot.active {
    width: 39px;
    background: #07518d;
  }

  .testimonial-dot:hover {
    background: #07518d;
  }

  @keyframes testimonialFade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Tablet and mobile */
  @media (max-width: 768px) {
    .client-appreciation {
      padding: 55px 22px 65px;
    }

    .testimonial-heading {
      font-size: 30px;
      margin-bottom: 40px;
      text-align: center;
    }

    .testimonial-slide {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 22px;
    }

    .testimonial-profile {
      width: 105px;
      height: 105px;
      margin: 0 auto;
    }

    .testimonial-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      width: 100%;
      max-width: 580px;
      margin: 0 auto;
    }

    .testimonial-company {
      margin-bottom: 16px;
      font-size: 13px;
      text-align: center;
    }

    .testimonial-text {
      font-size: 16px;
      line-height: 1.75;
      text-align: center;
    }

    .testimonial-person {
      margin-top: 24px;
      text-align: center;
    }

    .testimonial-person h3 {
      font-size: 20px;
      text-align: center;
    }

    .testimonial-person p {
      font-size: 14px;
      text-align: center;
    }

    .testimonial-controls {
      margin-top: 35px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial-slide {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.client-appreciation').forEach((section) => {
    const slides = Array.from(
      section.querySelectorAll('.testimonial-slide')
    )

    const dots = Array.from(
      section.querySelectorAll('.testimonial-dot')
    )

    const toggleButton = section.querySelector<HTMLButtonElement>('[data-autoplay-toggle]')
    const pauseIcon = toggleButton?.querySelector<SVGElement>('.icon-pause')
    const playIcon = toggleButton?.querySelector<SVGElement>('.icon-play')

    if (slides.length <= 1) return

    const autoplayEnabled =
      section.dataset.autoplay === 'true'

    const interval =
      Number(section.dataset.interval) || 5

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let userPaused = prefersReducedMotion
    let isHoveredOrFocused = false
    let currentIndex = 0
    let timer: ReturnType<typeof setInterval> | undefined

    function updateToggleButton() {
      if (!toggleButton) return
      toggleButton.setAttribute('aria-pressed', String(userPaused))
      toggleButton.setAttribute(
        'aria-label',
        userPaused ? 'Play testimonial autoplay' : 'Pause testimonial autoplay'
      )
      if (pauseIcon && playIcon) {
        pauseIcon.style.display = userPaused ? 'none' : 'block'
        playIcon.style.display = userPaused ? 'block' : 'none'
      }
    }

    function showSlide(index: number) {
      currentIndex = index

      slides.forEach((slide, i) => {
        slide.classList.toggle('active', i === index)

        slide.setAttribute(
          'aria-hidden',
          String(i !== index)
        )
      })

      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === index)

        dot.setAttribute(
          'aria-current',
          String(i === index)
        )
      })
    }

    function stopAutoplay() {
      if (timer) {
        clearInterval(timer)
        timer = undefined
      }
    }

    function startAutoplay() {
      stopAutoplay()

      if (!autoplayEnabled || userPaused || isHoveredOrFocused || prefersReducedMotion) return

      timer = setInterval(() => {
        showSlide((currentIndex + 1) % slides.length)
      }, Math.max(interval, 1) * 1000)
    }

    toggleButton?.addEventListener('click', () => {
      userPaused = !userPaused
      if (userPaused) {
        stopAutoplay()
      } else {
        startAutoplay()
      }
      updateToggleButton()
    })

    // Pause on hover
    section.addEventListener('mouseenter', () => {
      isHoveredOrFocused = true
      stopAutoplay()
    })
    section.addEventListener('mouseleave', () => {
      isHoveredOrFocused = false
      startAutoplay()
    })

    // Pause on focus within carousel
    section.addEventListener('focusin', () => {
      isHoveredOrFocused = true
      stopAutoplay()
    })
    section.addEventListener('focusout', (event) => {
      const related = (event as FocusEvent).relatedTarget as Node | null
      if (!section.contains(related)) {
        isHoveredOrFocused = false
        startAutoplay()
      }
    })

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        stopAutoplay()
        showSlide(index)
      })
    })

    if (!userPaused) {
      startAutoplay()
    }
    updateToggleButton()
  })
</script>
