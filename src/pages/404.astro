---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Page Not Found" description="The page you are looking for does not exist.">
  <section class="not-found-section">
    <div class="not-found-container">
      <span class="error-badge">404</span>
      <h1 class="error-heading">Page Not Found</h1>
      <p class="error-description">
        The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
      </p>
      <a href="/" class="back-home-btn">
        Return to Homepage <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .not-found-section {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
    text-align: center;
    background: #ffffff;
  }

  .not-found-container {
    max-width: 560px;
    margin: 0 auto;
  }

  .error-badge {
    display: inline-block;
    padding: 6px 16px;
    font-size: 14px;
    font-weight: 700;
    color: #004681;
    background: #eef5fc;
    border-radius: 999px;
    margin-bottom: 20px;
    letter-spacing: 0.05em;
  }

  .error-heading {
    font-size: clamp(32px, 5vw, 44px);
    font-weight: 700;
    color: #0b1f3a;
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .error-description {
    font-size: 16px;
    line-height: 1.6;
    color: #556987;
    margin-bottom: 32px;
  }

  .back-home-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    background: #004681;
    color: #ffffff;
    font-weight: 600;
    font-size: 15px;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .back-home-btn:hover {
    background: #003360;
    transform: translateY(-1px);
  }

  .back-home-btn:focus-visible {
    outline: 3px solid #60a5fa;
    outline-offset: 3px;
  }
</style>
